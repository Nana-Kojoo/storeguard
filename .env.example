# development | production
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-in-development
# SQLite for local dev; PostgreSQL in production, e.g. postgresql+psycopg://user:pass@host:5432/storeguard
DATABASE_URL=sqlite:///storeguard.db
# Set true when served over HTTPS (default true in production)
SESSION_COOKIE_SECURE=false
SESSION_HOURS=12
# Set false after the first business is created to stop public sign-ups
ALLOW_REGISTRATION=true
# Number of reverse proxies in front of the app (for correct client IPs / HTTPS detection)
TRUSTED_PROXIES=0
LOG_LEVEL=INFO
# Offer the "run on your store PC" Windows download on the home page
DOWNLOADS_ENABLED=true
# Developer / support contact shown on the home page, the Help page and in the Windows download.
# Leave a value empty to hide it. WhatsApp and phone in international format, e.g. +233 24 123 4567
SUPPORT_NAME=Nana Kojo
SUPPORT_ROLE=Developer of StoreGuard
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
SUPPORT_WEBSITE=https://nana-kojo.vercel.app
SUPPORT_HOURS=Monday to Saturday, 8am to 8pm (GMT)
